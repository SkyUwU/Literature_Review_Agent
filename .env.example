# Copy this file to .env and fill in the value locally. Never commit .env.
# Gemini keys: get them from https://aistudio.google.com/apikey
# Key 1 also drives the screening stage, so it is the busiest key; --plan-key N
# moves both to GEMINI_API_KEY_N when key 1 runs out of quota.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Groq (optional): when set, all full-run LLM stages including per-paper notes use Groq.
GROQ_API_KEY=
# Optional model selection: GROQ_MODEL sets the default for every Groq stage;
# per-stage values override it. Check model IDs and quota in the Groq Console.
GROQ_MODEL=
GROQ_MODEL_PLAN=
GROQ_MODEL_SCREENING=
GROQ_MODEL_SCORING=
GROQ_MODEL_NOTES=
GROQ_MODEL_REPORT=
# Estimated prompt token budget for each section-bounded per-paper notes request.
GROQ_NOTES_BATCH_TOKENS=2500
# Optional provider selector: openai, groq, or gemini. If blank, preserve the
# existing behavior (GROQ_API_KEY selects Groq; otherwise use Gemini).
LLM_PROVIDER=
# OpenAI (optional): set LLM_PROVIDER=openai and provide an API Platform key.
# The official SDK uses its default endpoint; no Base URL is needed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODEL_PLAN=
OPENAI_MODEL_SCREENING=
OPENAI_MODEL_SCORING=
OPENAI_MODEL_NOTES=
OPENAI_MODEL_REPORT=
# Gemini free-tier guardrails (per process, per key). RPM=5 means a 13s minimum
# gap between calls on the same key; RPD=20 stops a single run from spending more
# than the daily ceiling. A provider 429 for the daily budget is never retried —
# a rejected request still counts, so retrying only spends more quota.
# Check the live remaining quota at https://ai.dev/rate-limit before a real run.
GEMINI_REQUESTS_PER_MINUTE=5
GEMINI_REQUESTS_PER_DAY=20
GEMINI_429_RETRIES=1
# Semantic Scholar API key (optional): makes the full run use SS as the primary
# search source; without it the pipeline falls back to OpenAlex.
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex API key (optional): sent as a bearer token so OpenAlex uses your
# dedicated daily budget (10x the anonymous pool) for search and DOI abstract
# backfill. Get one free at https://openalex.org/settings/api
OPENALEX_API_KEY=
# Optional DOI-based OA recovery for screened keep/maybe papers; kept local.
UNPAYWALL_EMAIL=
# Local Ollama endpoint (optional, M6): when set, functional scoring tries Ollama first.
OLLAMA_BASE_URL=
# Langfuse observability (optional): host URL + public/secret keys for tracing.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
